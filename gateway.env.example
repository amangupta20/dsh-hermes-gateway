# Copy to gateway.env and fill in a real key. Never commit gateway.env.
# IMPORTANT: this file must NOT be named `.env` — dsh itself reads `./.env`
# from its working directory and refuses ALL DSH_* names from any file
# (bootstrap-only guard); only the inherited environment may supply them.
# (DSH_GATEWAY_ENV itself is export-only for the same chicken-and-egg reason.)
# Generate a key with: openssl rand -hex 32
DSH_GATEWAY_KEY=replace-me-openssl-rand-hex-32
PORT=8642
DSH_WORKSPACE=/home/aman/dshpaperclip
DSH_PROFILE=headless
DSH_MODEL=muse-spark-1.3-contributor
# DSH_BIN=dsh
# DSH_GATEWAY_DATA=./.dsh-hermes-gateway
# DSH_GATEWAY_ENV=/path/to/custom.env
# DSH_PREAMBLE=
